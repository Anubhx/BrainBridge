    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const msg = j.error_message || 'Enrichment error';\n  if (Array.isArray(j.ids) && j.ids.length && !j.id) {\n    for (const id of j.ids) out.push({ json: { id, error_message: msg } });\n  } else if (j.id) {\n    out.push({ json: { id: j.id, error_message: msg } });\n  }\n}\nreturn out;"
      },
