    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const ids = (it.json && it.json.ids) || [];\n  for (const id of ids) out.push({ json: { id, error_message: 'Gemini API call failed' } });\n}\nreturn out;"
      },
