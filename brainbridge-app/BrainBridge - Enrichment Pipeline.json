    {
      "parameters": {
        "jsCode": "const SYS = \"You are a concise knowledge assistant. For each topic provided, return a JSON array.\\nFor every item return an object with:\\n- id: the original id\\n- summary: 1-2 clear sentences explaining what it is\\n- links: array of 2-3 objects { \\\"title\\\": \\\"...\\\", \\\"url\\\": \\\"...\\\" } (prefer official or high-quality sources)\\n- tags: array of 1-4 short tags\\n- confidence: \\\"high\\\" | \\\"medium\\\" | \\\"low\\\"\\nIf the topic is too vague or you truly don't know, set confidence to \\\"low\\\" and give a short honest reply.\\nReturn ONLY valid JSON. No markdown.\";\nconst BATCH = 8;\nconst rows = $('Mark as Processing').all().map(i => i.json);\nconst out = [];\nfor (let i = 0; i < rows.length; i += BATCH) {\n  const slice = rows.slice(i, i + BATCH);\n  const batch = slice.map(r => ({ id: r.id, content: r.content }));\n  const ids = slice.map(r => r.id);\n  const requestBody = {\n    system_instruction: { parts: [{ text: SYS }] },\n    contents: [{ role: 'user', parts: [{ text: JSON.stringify(batch) }] }],\n    generationConfig: { response_mime_type: 'application/json' },\n  };\n  out.push({ json: { ids, batch, requestBody } });\n}\nreturn out;"
      },
      "id": "e7a5d31b-89f4-4a7d-a4d2-afa1a2efde2f",
      "name": "Prepare Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {}
      },
