    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst batches = $('Prepare Batches').all().map(i => i.json);\nconst out = [];\nfor (let k = 0; k < responses.length; k++) {\n  const resp = responses[k].json || {};\n  const b = batches[k] || {};\n  const batchItems = b.batch || [];\n  const ids = b.ids || [];\n  try {\n    const text = ((((resp.candidates || [])[0] || {}).content || {}).parts || [])[0]?.text || '';\n    const parsed = JSON.parse(text);\n    if (!Array.isArray(parsed)) throw new Error('Response was not a JSON array');\n    const contentById = {};\n    batchItems.forEach(bi => { contentById[bi.id] = bi.content; });\n    for (const obj of parsed) {\n      const valid = obj && obj.id && obj.summary && Array.isArray(obj.links) && Array.isArray(obj.tags) && obj.confidence;\n      if (!valid) {\n        out.push({ json: { _parseError: true, id: obj && obj.id ? obj.id : null, ids, error_message: 'Invalid enrichment object' } });\n        continue;\n      }\n      out.push({ json: {\n        _parseError: false,\n        id: obj.id,\n        content: contentById[obj.id] || '',\n        summary: obj.summary,\n        links: obj.links,\n        tags: obj.tags,\n        confidence: obj.confidence,\n      } });\n    }\n  } catch (e) {\n    out.push({ json: { _parseError: true, ids, error_message: 'JSON parse failed' } });\n  }\n}\nreturn out;"
      },
      "id": "be07434a-bffc-4c02-9f8b-a3220632d85d",
